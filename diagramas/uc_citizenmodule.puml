@startuml uc_citizenmodule
skinparam actorStyle awesome
skinparam usecaseBorderColor #2c3e50
skinparam usecaseBackgroundColor #ecf0f1
skinparam actorBorderColor #2c3e50
skinparam arrowColor #2c3e50
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12

top to bottom direction

actor "Administrador" as Admin #dae8fc
actor "Operador" as Op #fff2cc

rectangle "Módulo de Población (CitizenModule)" {

    rectangle "  Gestión de Ciudadanos  " as CIT {
        usecase "Consultar listado\nde ciudadanos" as UC_List
        usecase "Buscar ciudadano" as UC_Search
        usecase "Ver detalle\nde ciudadano" as UC_Detail
        usecase "Crear ciudadano" as UC_Create
        usecase "Editar ciudadano" as UC_Edit
        usecase "Desactivar\nciudadano" as UC_Disable
        usecase "Eliminar\nciudadano" as UC_Delete
    }

    rectangle "  Gestión de Documentos  " as DOC {
        usecase "Ver documentos\ndel ciudadano" as UC_ViewDocs
        usecase "Adjuntar\ndocumento" as UC_AddDoc
        usecase "Abrir documento" as UC_OpenDoc
        usecase "Eliminar\ndocumento" as UC_DeleteDoc
    }
}

UC_Detail ..> UC_ViewDocs : <<include>>
UC_Search ..> UC_List : <<include>>
UC_AddDoc ..> UC_ViewDocs : <<include>>

Admin -down-> UC_List
Admin -down-> UC_Search
Admin -down-> UC_Detail
Admin -down-> UC_Create
Admin -down-> UC_Edit
Admin -down-> UC_Disable
Admin -down-> UC_Delete
Admin -down-> UC_ViewDocs
Admin -down-> UC_AddDoc
Admin -down-> UC_OpenDoc
Admin -down-> UC_DeleteDoc

Op -down-> UC_List
Op -down-> UC_Search
Op -down-> UC_Detail
Op -down-> UC_ViewDocs
Op -down-> UC_AddDoc
Op -down-> UC_OpenDoc

@enduml
