@startuml er_appshell
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam linetype ortho
skinparam entityBorderColor #2c3e50
skinparam entityBackgroundColor #ecf0f1
skinparam arrowColor #2c3e50

title Diagrama Entidad-Relación - Base de Datos Principal (App Shell)

entity "users" as Users {
    * id : INT <<PK>> <<AUTO_INCREMENT>>
    --
    * username : VARCHAR(80)
    * email : VARCHAR(150) <<UNIQUE>>
    * password_hash : VARCHAR(255)
    * role : VARCHAR(40)
    * active : BOOLEAN
    * created_at : TIMESTAMP
}

entity "licences" as Licences {
    * id : INT <<PK>> <<AUTO_INCREMENT>>
    --
    * module_name : VARCHAR(100)
    * licence_key : VARCHAR(255) <<UNIQUE>>
    issued_to : VARCHAR(150)
    * expiry_date : DATE
    * active : BOOLEAN
    * created_at : TIMESTAMP
}

note right of Users
  role: 'admin' | 'operator'
  password_hash: BCrypt $2a$12$
  Credenciales por defecto:
  admin@centralcore.local / Admin1234
end note

note right of Licences
  module_name vincula la licencia
  a un módulo concreto.
  Ejemplos: 'citizen_db', 'traffic'
  Verificación en tiempo de carga
  del módulo.
end note

@enduml
