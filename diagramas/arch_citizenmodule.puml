@startuml arch_citizenmodule
skinparam componentStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam shadowing false
skinparam componentBorderColor #2c3e50
skinparam componentBackgroundColor #ecf0f1
skinparam packageBorderColor #7f8c8d
skinparam packageBackgroundColor #fafafa
skinparam arrowColor #2c3e50
skinparam databaseBackgroundColor #d5e8d4
skinparam databaseBorderColor #27ae60
skinparam noteBorderColor #e67e22
skinparam noteBackgroundColor #fdebd0

title Arquitectura - Módulo de Población (CitizenModule)

together {
    package "Entrada" as ENTRY {
        component [CitizenModule\nimplements Module] as Entry
    }

    package "Presentación (JavaFX)" as UI {
        component [citizen.fxml] as FXML
        component [CitizenModuleController] as Ctrl
        component [TableView<Citizen>\n(búsqueda en tiempo real)] as Table
        component [StackPane\n(Detalle / Edición / Vacío)] as Stack
        component [ListView<CitizenDocument>] as DocList
    }
}

together {
    package "Modelo" as MODEL {
        component [Citizen (POJO)] as CModel
        component [CitizenDocument (POJO)] as DocModel
    }

    package "Acceso a Datos" as DAL {
        component [CitizenDAO\n(CRUD ciudadanos\n+ documentos)] as DAO
    }

    package "Sistema de Ficheros" as FS {
        component [FileChooser] as FC
        component [Files.copy()] as Copy
        component [Desktop.open()] as DOpen
    }
}

database "H2 Shared\nciudadanos\nciudadano_documentos" as H2

Entry --> FXML
Entry --> Ctrl
Ctrl --> Table
Ctrl --> Stack
Ctrl --> DocList
Ctrl --> DAO
Ctrl --> FC
FC --> Copy
Ctrl --> DOpen
Table --> CModel
DocList --> DocModel
DAO --> H2

note right of Ctrl
  textProperty listener filtra
  ObservableList sin tocar BD.
  StackPane alterna vistas
  sin recargar FXML.
end note

note bottom of DAO
  DDL idempotente con
  IF NOT EXISTS +
  ALTER TABLE ADD COLUMN
  IF NOT EXISTS (H2-safe).
end note

@enduml
