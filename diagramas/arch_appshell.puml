@startuml arch_appshell
skinparam componentStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 12
skinparam shadowing false
skinparam componentBorderColor #2c3e50
skinparam componentBackgroundColor #ecf0f1
skinparam packageBorderColor #7f8c8d
skinparam packageBackgroundColor #fafafa
skinparam arrowColor #2c3e50
skinparam databaseBackgroundColor #d5e8d4
skinparam databaseBorderColor #27ae60
skinparam noteBorderColor #e67e22
skinparam noteBackgroundColor #fdebd0

title Arquitectura - CentralCore App Shell

together {
    package "Presentación (JavaFX)" as UI {
        component [Welcome\nLogin] as AuthViews
        component [MainShell\n+ Sidebar] as Shell
        component [ModulesView\nInstalls\nLicences\nSettings] as SubViews
    }

    package "Utilidades" as UTIL {
        component [SceneManager\n(navegación)] as SceneMan
        component [SessionManager\n(sesión activa)] as SessionMan
        component [TranslationManager\n(i18n + observer)] as TransMan
        component [CustomTitleBar] as TitleBar
    }
}

together {
    package "Sistema de Módulos" as MODS {
        component [Module\n<<interface>>] as ModIface
        component [ModuleLoader\n(reflexión +\nURLClassLoader)] as Loader
        component [ModuleManager\n(singleton)] as ModMan
    }

    package "Plugins cargados" as PLUGINS {
        component [CitizenModule.jar] as CitMod
        component [TrafficModule.jar] as TrfMod
    }
}

package "Acceso a Datos" as DAL {
    component [DatabaseConnection\n(singleton H2)] as DBConn
    component [SchemaInitializer\n(DDL idempotente)] as Schema
    component [UserDAO] as UserDAO
}

database "H2 Embedded\n~/centralcore_db" as H2

' Flujo principal
AuthViews --> SceneMan
SceneMan --> Shell
Shell --> SubViews
Shell --> ModMan
Shell --> TitleBar
SessionMan --> SceneMan
TransMan <--> Shell

' Módulos
ModMan --> Loader
Loader --> ModIface
Loader --> CitMod
Loader --> TrfMod
CitMod ..|> ModIface
TrfMod ..|> ModIface
SceneMan --> ModIface : getMainUI()

' DB
UserDAO --> DBConn
DBConn --> Schema
DBConn --> H2

note bottom of Loader
  URLClassLoader aislado
  por módulo. Descubrimiento
  via module.json + Gson.
end note

note bottom of H2
  AUTO_SERVER=TRUE
  BCrypt $2a$12$
end note

@enduml
