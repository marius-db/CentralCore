<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--vista de instalaciones - muestra todos los modulos instalados con opciones de gestion
    cada modulo se muestra como una fila de lista personalizada con nombre, descripcion y menu de acciones-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.InstallsController"
      style="-fx-background-color: #2c3e50; -fx-spacing: 0; -fx-padding: 0;">

    <!--cabecera de la pagina-->
    <HBox style="-fx-padding: 15 20; -fx-background-color: #34495e; -fx-border-color: #2c3e50; -fx-border-width: 0 0 1 0;">
        <Label text="Installed Modules" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
    </HBox>

    <!--lista de modulos-->
    <ListView fx:id="moduleListView"
              VBox.vgrow="ALWAYS"
              style="-fx-control-inner-background: #2c3e50; -fx-border-color: #34495e;"/>

</VBox>
