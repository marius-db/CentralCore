<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--vista de instalaciones, muestra todos los módulos instalados con opciones de gestion
    cada módulo se muestra como una fila de lista personalizada con nombre, descripcion y menu de acciones-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.InstallsController"
      style="-fx-background-color: #2c3e50; -fx-spacing: 0; -fx-padding: 0;">

    <!--cabecera, título a la izquierda, botón de recarga pegado a la derecha-->
    <HBox spacing="10" style="-fx-alignment: center-left; -fx-padding: 20;">
        <Label fx:id="lblTitle" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRefresh"
                onAction="#onRefreshModules"
                style="-fx-font-size: 13; -fx-padding: 8 16; -fx-cursor: hand;
                       -fx-background-color: #34495e; -fx-text-fill: #ecf0f1;
                       -fx-border-color: #7f8c8d; -fx-border-width: 1;
                       -fx-border-radius: 4; -fx-background-radius: 4;"/>
    </HBox>

    <!--lista de módulos sin borde visible-->
    <ListView fx:id="moduleListView"
              VBox.vgrow="ALWAYS"
              style="-fx-control-inner-background: #2c3e50; -fx-border-color: transparent; -fx-background-color: transparent; -fx-background: #2c3e50;"/>

</VBox>