<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--vista de licencias, usa el mismo patron de lista que installs-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.LicencesController"
      style="-fx-background-color: #2c3e50; -fx-spacing: 0; -fx-padding: 0;">

    <!--cabecera-->
    <HBox style="-fx-padding: 20; -fx-spacing: 10; -fx-alignment: center-left;">
        <Label fx:id="lblTitle" text="Licences" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRemove" text="Remove" onAction="#onRemoveLicenceClicked"
                style="-fx-padding: 8 15; -fx-font-size: 11; -fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 2;"/>
        <Button fx:id="btnAdd" text="+ Add Licence" onAction="#onAddLicenceClicked"
                style="-fx-padding: 8 15; -fx-font-size: 11; -fx-background-color: #3498db; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-border-color: #2980b9; -fx-border-width: 1; -fx-border-radius: 2;"/>
    </HBox>

    <!--lista de licencias, misma estructura que modulos en installs-->
    <ListView fx:id="licenceListView"
              VBox.vgrow="ALWAYS"
              visible="false" managed="false"
              style="-fx-control-inner-background: #2c3e50; -fx-border-color: #34495e;"/>

    <!--empty state-->
    <VBox fx:id="emptyState" VBox.vgrow="ALWAYS"
          style="-fx-alignment: center; -fx-padding: 40; -fx-spacing: 12; -fx-background-color: #2c3e50;">
        <Label fx:id="lblEmptyTitle" text="No Licence Added"
               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;"/>
        <Label fx:id="lblEmptyDesc" text="Add a licence key to unlock the application."
               style="-fx-font-size: 12; -fx-text-fill: #95a5a6;" wrapText="true"/>
        <Button fx:id="btnAddFirst" text="Add Licence" onAction="#onAddLicenceClicked"
                style="-fx-padding: 10 20; -fx-font-size: 13; -fx-background-color: #3498db; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-border-color: #2980b9; -fx-border-width: 1; -fx-border-radius: 2;"
                prefWidth="200"/>
    </VBox>

</VBox>