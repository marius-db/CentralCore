<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--vista de licencias - gestionar y activar licencias de modulos-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.LicencesController"
      style="-fx-background-color: #2c3e50; -fx-spacing: 0; -fx-padding: 0;">

    <!--cabecera de la pagina-->
    <HBox style="-fx-padding: 15 20; -fx-background-color: #34495e; -fx-border-color: #2c3e50; -fx-border-width: 0 0 1 0; -fx-spacing: 10; -fx-alignment: center-left;">
        <Label text="Licences" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="+ Add Licence" onAction="#onAddLicenceClicked"
                style="-fx-padding: 8 15; -fx-font-size: 12; -fx-background-color: #3498db; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-border-color: #2980b9; -fx-border-width: 1; -fx-border-radius: 2;"/>
    </HBox>

    <!--placeholder de info cuando no hay licencias-->
    <VBox VBox.vgrow="ALWAYS" style="-fx-alignment: center; -fx-padding: 40;">
        <Label text="No Licences Added" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #bdc3c7; -fx-alignment: center;"/>
        <Label text="Add a licence key to activate premium features for your modules."
               style="-fx-font-size: 12; -fx-text-fill: #95a5a6; -fx-alignment: center; -fx-wrap-text: true;"
               wrapText="true"/>
        <Button text="Add Your First Licence" onAction="#onAddLicenceClicked"
                style="-fx-padding: 10 20; -fx-font-size: 13; -fx-background-color: #27ae60; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-border-color: #229954; -fx-border-width: 1; -fx-border-radius: 2; -fx-margin-top: 20;"
                VBox.vgrow="NEVER" prefWidth="200"/>
    </VBox>

</VBox>
