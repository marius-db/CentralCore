<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<!--pantalla de bienvenida
    layout: StackPane raiz con city.png como fondo de toda la ventana
    encima va el HBox con panel izquierdo semitransparente + area derecha transparente
    el ImageView se ajusta al tamaño de la ventana via binding en el controlador
    el selector de idioma flota encima de todo en la esquina superior derecha-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.centralcore.controller.WelcomeController" styleClass="welcome-root">

    <!--imagen de ciudad como fondo completo de la ventana - tamaño vinculado al StackPane en el controlador-->
    <ImageView fx:id="imgCity"
               preserveRatio="false"
               StackPane.alignment="CENTER"/>

    <!--contenido principal encima de la imagen-->
    <HBox>

        <!--panel izquierdo: marca + llamada a la accion - fondo semitransparente para legibilidad-->
        <VBox styleClass="welcome-left" HBox.hgrow="NEVER">
            <VBox styleClass="welcome-brand">
                <Label text="CENTRAL" styleClass="logo-central"/>
                <Label text="CORE" styleClass="logo-core"/>
            </VBox>

            <VBox styleClass="welcome-tagline">
                <Label fx:id="lblTaglineTitle" styleClass="tagline-title" wrapText="true"/>
                <Label fx:id="lblTaglineSubtitle" styleClass="tagline-subtitle" wrapText="true"/>
            </VBox>

            <Button fx:id="btnLogin"
                    text="Log In"
                    styleClass="btn-primary"
                    onAction="#onLoginClicked"/>
        </VBox>

        <!--area derecha: transparente, la imagen de fondo se ve a traves-->
        <StackPane HBox.hgrow="ALWAYS"/>

    </HBox>

    <!--selector de idioma en la esquina superior derecha - mismo estilo que la pantalla login-->
    <ComboBox fx:id="cmbLanguage"
              StackPane.alignment="TOP_RIGHT"
              style="-fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-control-inner-background: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-padding: 5 10; -fx-font-size: 11; -fx-font-fill: #ecf0f1; -fx-focus-color: #3498db; -fx-cell-text-fill: #ecf0f1;"
              promptText="Language">
        <StackPane.margin><javafx.geometry.Insets top="15" right="15"/></StackPane.margin>
    </ComboBox>

</StackPane>