<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    modules view - displays all loaded modules as clickable tiles
    vista de modulos - muestra todos los modulos cargados como tiles clickeables

    tilepane automatically wraps tiles into a grid based on available width
    tilepane envuelve automaticamente los tiles en una grilla basada en el ancho disponible
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.ModulesViewController"
      spacing="15"
      style="-fx-padding: 20; -fx-background-color: #2c3e50;">

    <!-- header / cabecera -->
    <HBox spacing="10" style="-fx-alignment: center-left;">
        <Label text="Modules" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
    </HBox>

    <!-- tiles grid / grilla de tiles -->
    <ScrollPane fitToWidth="true" style="-fx-border-color: transparent; -fx-focus-color: transparent; -fx-background-color: #2c3e50;">
        <TilePane fx:id="tilePane"
                  prefColumns="3"
                  hgap="20"
                  vgap="20"
                  style="-fx-padding: 10; -fx-background-color: #2c3e50;"/>
    </ScrollPane>

</VBox>
