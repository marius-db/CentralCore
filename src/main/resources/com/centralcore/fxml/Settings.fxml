<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    settings view - app appearance and profile settings
    vista de configuracion - ajustes de apariencia y perfil de la app
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.SettingsController"
      style="-fx-background-color: #2c3e50; -fx-spacing: 0; -fx-padding: 0;">

    <!-- page header / cabecera de la pagina -->
    <HBox style="-fx-padding: 15 20; -fx-background-color: #34495e; -fx-border-color: #2c3e50; -fx-border-width: 0 0 1 0; -fx-spacing: 10; -fx-alignment: center-left;">
        <Label fx:id="lblTitle" text="Settings" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
    </HBox>

    <ScrollPane VBox.vgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-border-color: #34495e; -fx-padding: 0;" fitToWidth="true">
        <VBox style="-fx-padding: 25; -fx-spacing: 25; -fx-background-color: #2c3e50;">

            <!-- appearance section / seccion de apariencia -->
            <VBox style="-fx-spacing: 12;">
                <Label fx:id="lblAppearance" text="Appearance" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                <Separator style="-fx-border-color: #34495e; -fx-padding: 0;"/>

                <!-- dark mode toggle / toggle de modo oscuro -->
                <HBox style="-fx-padding: 12; -fx-background-color: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 3; -fx-spacing: 10; -fx-alignment: center-left;">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 4;">
                        <Label fx:id="lblDarkMode" text="Dark Mode" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                        <Label fx:id="lblDarkModeDesc" text="Use dark theme for reduced eye strain" style="-fx-font-size: 10; -fx-text-fill: #bdc3c7;"/>
                    </VBox>
                    <CheckBox fx:id="chkDarkMode" selected="true" style="-fx-padding: 5;"/>
                </HBox>
            </VBox>

            <!-- language section / seccion de idioma -->
            <VBox style="-fx-spacing: 12;">
                <Label fx:id="lblLanguageSection" text="Language" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                <Separator style="-fx-border-color: #34495e; -fx-padding: 0;"/>

                <!-- language selector / selector de idioma -->
                <HBox style="-fx-padding: 12; -fx-background-color: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 3; -fx-spacing: 10; -fx-alignment: center-left;">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 4;">
                        <Label fx:id="lblInterfaceLanguage" text="Interface Language" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                        <Label fx:id="lblLanguageDesc" text="Choose your preferred language" style="-fx-font-size: 10; -fx-text-fill: #bdc3c7;"/>
                    </VBox>
                    <ComboBox fx:id="cmbLanguage" style="-fx-background-color: #2c3e50; -fx-text-fill: #ecf0f1; -fx-control-inner-background: #34495e; -fx-cell-hover-color: #3498db; -fx-cell-focus-color: #3498db; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-padding: 5 10; -fx-font-size: 11; -fx-font-fill: #ecf0f1;"/>
                </HBox>
            </VBox>

            <!-- notifications section / seccion de notificaciones -->
            <VBox style="-fx-spacing: 12;">
                <Label fx:id="lblNotifications" text="Notifications" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                <Separator style="-fx-border-color: #34495e; -fx-padding: 0;"/>

                <!-- module updates / actualizaciones de modulos -->
                <HBox style="-fx-padding: 12; -fx-background-color: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 3; -fx-spacing: 10; -fx-alignment: center-left;">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 4;">
                        <Label fx:id="lblModuleUpdates" text="Module Updates" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                        <Label fx:id="lblModuleUpdatesDesc" text="Notify when module updates are available" style="-fx-font-size: 10; -fx-text-fill: #bdc3c7;"/>
                    </VBox>
                    <CheckBox fx:id="chkModuleUpdates" selected="true" style="-fx-padding: 5;"/>
                </HBox>

                <!-- system notifications / notificaciones del sistema -->
                <HBox style="-fx-padding: 12; -fx-background-color: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 3; -fx-spacing: 10; -fx-alignment: center-left;">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 4;">
                        <Label fx:id="lblSystemAlerts" text="System Alerts" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                        <Label fx:id="lblSystemAlertsDesc" text="Show system and error alerts" style="-fx-font-size: 10; -fx-text-fill: #bdc3c7;"/>
                    </VBox>
                    <CheckBox fx:id="chkSystemAlerts" selected="true" style="-fx-padding: 5;"/>
                </HBox>
            </VBox>

            <!-- database section / seccion de base de datos -->
            <VBox style="-fx-spacing: 12;">
                <Label fx:id="lblDatabase" text="Database" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                <Separator style="-fx-border-color: #34495e; -fx-padding: 0;"/>

                <!-- connection test / prueba de conexion -->
                <HBox style="-fx-padding: 12; -fx-background-color: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 3; -fx-spacing: 10; -fx-alignment: center-left;">
                    <VBox HBox.hgrow="ALWAYS" style="-fx-spacing: 4;">
                        <Label fx:id="lblConnectionStatus" text="Connection Status" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                        <Label fx:id="lblConnStatus" text="Testing..." style="-fx-font-size: 10; -fx-text-fill: #bdc3c7;"/>
                    </VBox>
                    <Button fx:id="btnTestConn" text="Test Connection" onAction="#onTestConnectionClicked"
                            style="-fx-padding: 8 15; -fx-font-size: 11; -fx-background-color: #3498db; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-border-color: #2980b9; -fx-border-width: 1; -fx-border-radius: 2;"/>
                </HBox>
            </VBox>

            <!-- about section / seccion de acerca de -->
            <VBox style="-fx-spacing: 12;">
                <Label fx:id="lblAbout" text="About" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                <Separator style="-fx-border-color: #34495e; -fx-padding: 0;"/>

                <VBox style="-fx-padding: 12; -fx-background-color: #34495e; -fx-border-color: #7f8c8d; -fx-border-width: 1; -fx-border-radius: 3; -fx-spacing: 8;">
                    <Label text="CentralCore v1.0.0" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;"/>
                    <Label text="City administration and module management system" style="-fx-font-size: 10; -fx-text-fill: #bdc3c7;"/>
                    <Label text="© 2026 All rights reserved" style="-fx-font-size: 9; -fx-text-fill: #95a5a6;"/>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
