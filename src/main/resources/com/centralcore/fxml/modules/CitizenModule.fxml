<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    citizen database module view
    vista del modulo de base de datos ciudadana

    full implementation: search bar + table of ciudadanos + add/edit/delete actions
    implementacion completa: barra de busqueda + tabla de ciudadanos + acciones agregar/editar/eliminar
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.controller.modules.CitizenModuleController"
      styleClass="view-root">

    <!-- module header with back button / cabecera del modulo con boton volver -->
    <HBox styleClass="view-header">
        <Button text="← Modules" styleClass="btn-ghost" onAction="#onBackClicked"/>
        <Label text="Citizen Database" styleClass="view-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="+ Add Citizen" styleClass="btn-primary" onAction="#onAddClicked"/>
    </HBox>

    <!-- search bar / barra de busqueda -->
    <HBox styleClass="module-toolbar">
        <TextField fx:id="txtSearch"
                   promptText="Search by name, DNI or address..."
                   styleClass="field-input"
                   HBox.hgrow="ALWAYS"
                   onKeyReleased="#onSearchTyped"/>
    </HBox>

    <!-- citizens table / tabla de ciudadanos -->
    <TableView fx:id="tableCitizens" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colDni"       text="DNI"       prefWidth="110"/>
            <TableColumn fx:id="colNombre"    text="Name"      prefWidth="160"/>
            <TableColumn fx:id="colApellidos" text="Surnames"  prefWidth="180"/>
            <TableColumn fx:id="colFechaNac"  text="D.O.B"     prefWidth="110"/>
            <TableColumn fx:id="colMunicipio" text="City"      prefWidth="120"/>
            <TableColumn fx:id="colTelefono"  text="Phone"     prefWidth="120"/>
            <TableColumn fx:id="colActions"   text=""          prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
