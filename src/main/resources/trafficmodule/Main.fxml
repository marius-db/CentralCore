<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--vista principal del modulo de trafico-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="10"
      style="-fx-padding: 20;">

    <Label text="Traffic Management Module" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    <Label text="This is the traffic module - completely independent from the app shell"/>
    
    <HBox spacing="10">
        <Button text="Report Incident" style="-fx-font-size: 12; -fx-padding: 10;"/>
        <Button text="View Map" style="-fx-font-size: 12; -fx-padding: 10;"/>
        <Button text="Analytics" style="-fx-font-size: 12; -fx-padding: 10;"/>
    </HBox>
    
    <Label text="[Traffic incidents list would go here]" style="-fx-text-fill: #999;"/>

</VBox>
