<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.centralcore.modules.citizenmodule.CitizenModuleController"
      styleClass="cm-root"
      stylesheets="@../css/Citizen.css"
      VBox.vgrow="ALWAYS">

    <!--panel izquierdo: lista de ciudadanos-->
    <VBox styleClass="cm-list-panel" minWidth="340" maxWidth="340">

        <HBox styleClass="cm-list-header" alignment="CENTER_LEFT" spacing="8">
            <TextField fx:id="searchField" styleClass="cm-search"
                       promptText="Buscar por nombre, DNI, municipio…"
                       HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNuevo" styleClass="btn-primary" text="+ Nuevo" onAction="#onNuevo"/>
        </HBox>

        <TableView fx:id="citizenTable" styleClass="cm-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDni"       text="DNI / NIE"       prefWidth="90"/>
                <TableColumn fx:id="colNombre"    text="Nombre completo"  prefWidth="160"/>
                <TableColumn fx:id="colMunicipio" text="Municipio"        prefWidth="80"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

    </VBox>

    <Separator orientation="VERTICAL" styleClass="cm-divider"/>

    <!--panel derecho-->
    <StackPane fx:id="rightPanel" HBox.hgrow="ALWAYS">

        <!--estado vacio-->
        <VBox fx:id="emptyState" styleClass="cm-empty-state" alignment="CENTER" spacing="12">
            <Label text="👤" style="-fx-font-size:48;"/>
            <Label text="Selecciona un ciudadano" styleClass="cm-empty-title"/>
            <Label text="o crea uno nuevo con el botón + Nuevo" styleClass="cm-empty-subtitle"/>
        </VBox>

        <!--vista detalle (lectura)-->
        <ScrollPane fx:id="detailView" styleClass="cm-scroll" fitToWidth="true"
                    visible="false" managed="false">
            <VBox styleClass="cm-detail-panel" spacing="0">

                <VBox styleClass="cm-detail-header" spacing="6">
                    <Label fx:id="detailNombre" styleClass="cm-detail-name"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="detailDni" styleClass="cm-detail-dni"/>
                        <Label fx:id="detailEstado" styleClass="status-active" text="Activo"/>
                    </HBox>
                    <HBox styleClass="cm-detail-actions" spacing="8">
                        <Button fx:id="btnEditar"   styleClass="btn-primary" text="Editar"   onAction="#onEditar"/>
                        <Button fx:id="btnEliminar" styleClass="btn-danger"  text="Eliminar" onAction="#onEliminar"/>
                    </HBox>
                </VBox>

                <VBox styleClass="cm-section" spacing="10">
                    <Label text="DATOS PERSONALES" styleClass="cm-section-title"/>
                    <GridPane hgap="16" vgap="9">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" maxWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Fecha / lugar nac."  styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailNacimiento"   styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Nacionalidad"        styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailNacionalidad" styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Sexo"                styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailSexo"         styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Estado civil"        styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="detailEstadoCivil"  styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="cm-section" spacing="10">
                    <Label text="CONTACTO Y DOMICILIO" styleClass="cm-section-title"/>
                    <GridPane hgap="16" vgap="9">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" maxWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Dirección"        styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailDireccion" styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Municipio"        styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailMunicipio" styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Código postal"    styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailCp"        styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Teléfono"         styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="detailTelefono"  styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Email"            styleClass="cm-field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="detailEmail"     styleClass="cm-field-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="cm-section" spacing="10">
                    <Label text="DOCUMENTOS" styleClass="cm-section-title"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="docTypeCombo" styleClass="cm-combo" prefWidth="210"/>
                        <Button fx:id="btnAddDoc" styleClass="btn-ghost-blue"
                                text="Subir archivo" onAction="#onAddDoc"/>
                    </HBox>
                    <ListView fx:id="docList" styleClass="cm-doc-list" prefHeight="200"/>
                    <HBox spacing="8">
                        <Button fx:id="btnOpenDoc"   styleClass="btn-ghost"       text="Abrir"        onAction="#onOpenDoc"/>
                        <Button fx:id="btnDeleteDoc" styleClass="btn-ghost-danger" text="Eliminar doc" onAction="#onDeleteDoc"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>

        <!--formulario edicion / creacion-->
        <ScrollPane fx:id="editView" styleClass="cm-scroll" fitToWidth="true"
                    visible="false" managed="false">
            <VBox styleClass="cm-edit-panel" spacing="20">

                <Label fx:id="editTitle" styleClass="cm-edit-title"/>

                <VBox styleClass="cm-form-section" spacing="12">
                    <Label text="DATOS PERSONALES" styleClass="cm-section-title"/>

                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="DNI / NIE *" styleClass="field-label"/>
                            <TextField fx:id="editDni" styleClass="field-input" promptText="12345678A"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Sexo" styleClass="field-label"/>
                            <ComboBox fx:id="editSexo" styleClass="cm-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Nombre *" styleClass="field-label"/>
                            <TextField fx:id="editNombre" styleClass="field-input" promptText="Nombre"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Apellidos *" styleClass="field-label"/>
                            <TextField fx:id="editApellidos" styleClass="field-input"
                                       promptText="Primer apellido Segundo apellido"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Fecha de nacimiento *" styleClass="field-label"/>
                            <DatePicker fx:id="editFechaNac" styleClass="cm-datepicker" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Lugar de nacimiento" styleClass="field-label"/>
                            <TextField fx:id="editLugarNac" styleClass="field-input" promptText="Ciudad, País"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Nacionalidad" styleClass="field-label"/>
                            <TextField fx:id="editNacionalidad" styleClass="field-input" promptText="Española"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Estado civil" styleClass="field-label"/>
                            <ComboBox fx:id="editEstadoCivil" styleClass="cm-combo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="cm-form-section" spacing="12">
                    <Label text="CONTACTO Y DOMICILIO" styleClass="cm-section-title"/>

                    <VBox spacing="4">
                        <Label text="Dirección" styleClass="field-label"/>
                        <TextField fx:id="editDireccion" styleClass="field-input" promptText="Calle, número, piso"/>
                    </VBox>

                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Municipio" styleClass="field-label"/>
                            <TextField fx:id="editMunicipio" styleClass="field-input" promptText="Municipio"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="130">
                            <Label text="Código postal" styleClass="field-label"/>
                            <TextField fx:id="editCp" styleClass="field-input" promptText="14000"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Teléfono" styleClass="field-label"/>
                            <TextField fx:id="editTelefono" styleClass="field-input" promptText="600 000 000"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Email" styleClass="field-label"/>
                            <TextField fx:id="editEmail" styleClass="field-input" promptText="correo@ejemplo.com"/>
                        </VBox>
                    </HBox>
                </VBox>

                <CheckBox fx:id="editActivo" text="Registro activo" styleClass="cm-checkbox"/>

                <Label fx:id="editError" styleClass="login-error" visible="false" managed="false" wrapText="true"/>

                <HBox spacing="10">
                    <Button fx:id="btnGuardar"  styleClass="btn-primary" text="Guardar"  onAction="#onGuardar"/>
                    <Button fx:id="btnCancelar" styleClass="btn-ghost"   text="Cancelar" onAction="#onCancelar"/>
                </HBox>

            </VBox>
        </ScrollPane>

    </StackPane>

</HBox>
